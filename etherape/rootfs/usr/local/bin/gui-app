#!/bin/bash
# Launch EtherApe. Settings come from the environment (see etherape.dockerfile).
args=()
[ -n "${CAPTURE_INTERFACE:-}" ] && args+=(-i "$CAPTURE_INTERFACE")
args+=(-m "${ETHERAPE_MODE:-ip}")
[ -n "${ETHERAPE_FILTER:-}" ] && args+=(-f "$ETHERAPE_FILTER")
[ -n "${ETHERAPE_PCAP:-}" ] && args+=(-r "$ETHERAPE_PCAP")
# ETHERAPE_ARGS is split on spaces on purpose (extra command-line options).
# shellcheck disable=SC2086
exec etherape "${args[@]}" ${ETHERAPE_ARGS:-}
