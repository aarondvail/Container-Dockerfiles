# Copy to .env next to compose.yaml and fill in.

# Your domain: friends use https://share.<DOMAIN> and https://tracker.<DOMAIN>
DOMAIN=vail-industries.com

# Host folders to share (mounted read-only)
TV_DIR=/mnt/media/tv
MOVIES_DIR=/mnt/media/movies

# Secrets: generate with   openssl rand -hex 24
TRACKER_API_TOKEN=
QBIT_WEBUI_PASS=
QBIT_WEBUI_USER=admin

# Owner of /srv/sharebox and read access to the media
PUID=1000
PGID=1000
TZ=America/New_York

# Torrent listening port (forward TCP+UDP on your router to this host)
TORRENT_PORT=6881

# qBittorrent web UI for you (default: localhost only, port 8085)
QBIT_WEBUI_BIND=127.0.0.1
QBIT_WEBUI_HOST_PORT=8085

# true = share the existing library too; false = only new files from now on
SHARE_EXISTING=true

# auto = look up your public IP; or set a fixed IP
SEEDER_PUBLIC_IP=auto

SCAN_INTERVAL=300
SETTLE_SECONDS=600
HASH_THREADS=2
