[Unit]
Description=HylaFAX+ faxgetty on %i
Requires=iaxmodem@%i.service
After=iaxmodem@%i.service hylafax-faxq.service

[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /dev/%i ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/sbin/faxgetty %i
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
